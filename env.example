# Private LFM2.5 Audio service. Do not commit actual tokens.
LFM_AUDIO_HOST=127.0.0.1
LFM_AUDIO_PORT=10120
LFM_AUDIO_TOKEN=
LFM_AUDIO_MODEL=LiquidAI/LFM2.5-Audio-1.5B-JP
LFM_AUDIO_MAX_UPLOAD_BYTES=10485760
LFM_AUDIO_MAX_INPUT_CHARS=4000
# Set to the host CPU count for CPU-only deployments; 0 leaves PyTorch unchanged.
LFM_AUDIO_CPU_THREADS=0
# `liquid-audio` Python supports CPU ASR. TTS needs a CUDA runtime or a
# dedicated GGUF audio runner.
LFM_AUDIO_DEVICE=cpu
